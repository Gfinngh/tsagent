# ----- LLM -----
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Default model when none is given on the CLI / workflow
TSAGENT_MODEL=

# Model order: "test" (weakest first, quota-frugal) or "prod" (strongest first)
# Default: test
TSAGENT_MODEL_ORDER=

# ----- Event log -----
# Overrides the default `runs/host-<timestamp>.jsonl` path for the CLI
TSAGENT_LOG_PATH=

# ----- MCP / workspace -----
# Root for the file tools exposed by the MCP server
WORKSPACE_ROOT=
# Command the CLI spawns to start the MCP server (default: `tsx src/agent/server.ts`).
# Setting this marks the server UNTRUSTED: its self-reported tool permissions
# are ignored, and any tool without an explicit override defaults to `dangerous`.
MCP_SERVER_COMMAND=

# ----- execute_python sandbox -----
# Override the path to the Deno executable used by the sandbox tool
TSAGENT_DENO_PATH=

# ----- Web search -----
TAVILY_API_KEY=

# ----- Tracing (optional) -----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ----- Memory -----
# Path to the SQLite database used by MemoryStore (default: `.memory/memory.sqlite3`)
TSAGENT_MEMORY_DB=
# Auto-prune entries older than this many days on store open (default: no auto-prune)
# Only used when the store is constructed without an explicit `pruneAfterDays`.
TSAGENT_MEMORY_PRUNE_DAYS=